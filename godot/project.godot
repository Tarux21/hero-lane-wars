; Hero Lane Wars (Godot-Version, 3D). Regeln und Zahlen kommen aus data/daten.json (Export aus dem Browser-Prototyp).
config_version=5

[application]
config/name="Hero Lane Wars"
run/main_scene="res://scenes/main.tscn"
